# Contrasena del usuario lsg de PostgreSQL (requerido por docker compose).
# Generar una aleatoria: openssl rand -hex 24
POSTGRES_PASSWORD=changeme

# URL de conexion a PostgreSQL (requerido). Docker compose la sobrescribe con POSTGRES_PASSWORD;
# para uv run fuera de Docker, poner aqui la misma contrasena.
DATABASE_URL=postgresql+asyncpg://lsg:changeme@localhost:5432/lsg_routes

# Puerto del servidor
PORT=14141

# Activar modo debug (false en produccion)
DEBUG=false

# Cuenta de servicio LSG-Auth con rol admin, researcher o developer. Se usa SOLO para el adjust de
# puntos y el alta del sensor por jugador (link / link-endpoint); el ingest, el
# ledger y el saldo van con el token del propio participante. Sin configurar,
# esas llamadas caen al token del usuario y solo funcionan si tiene uno de esos roles.
# LSG_SERVICE_EMAIL=service@example.com
# LSG_SERVICE_PASSWORD=changeme

# URLs de servicios LSG (requerido)
# LSG_AUTH_BASE_URL=https://lsg.diinf.usach.cl/lsg-auth
# LSG_CORE_BASE_URL=https://lsg.diinf.usach.cl/lsg-core-api

# ID del sensor LSG-Routes en LSG-Core
# LSG_ROUTES_SENSOR_ID=6

# Un endpoint por modo de actividad, para que el mod de BG3 clasifique por
# id_sensor_endpoint. Se obtienen con: uv run python scripts/provision_endpoints.py
# LSG_ROUTES_ENDPOINT_IDS={"walking": 0, "jogging": 0, "hiking": 0}

# Habilita la bicicleta como actividad: la app la muestra como modo, se aprovisiona
# su sensor_endpoint y el recorrido libre puntua esas velocidades. En false esas
# velocidades cuentan como exceso. Ponerlo en true solo cuando se pueda probar.
# BIKE_ACTIVATE=false

# Endpoint por defecto para modos que no esten en el mapa de arriba
# LSG_ROUTES_SENSOR_ENDPOINT_ID=1

# Atributo de puntos al que se acredita: Social=1, Fisico=2, Afectivo=3, Mental=4
# LSG_ROUTES_ATTRIBUTE_ID=2

# [DEPRECADO en LSG-Core 1.2.3] Respaldo si LSG_ROUTES_ATTRIBUTE_ID=0
# LSG_ROUTES_POINT_DIMENSION_ID=1

# API key de OpenRouteService (requerida para rutas A-B)
# ORS_API_KEY=your_ors_api_key_here

# Factores de puntos por km segun modo
POINTS_PER_KM_WALKING=8
POINTS_PER_KM_CYCLING=4
POINTS_PER_KM_JOGGING=12
POINTS_PER_KM_HIKING=10

# Fraccion de esos factores que rinde un recorrido libre (sin ruta planificada)
POINTS_FREE_ROAM_MULTIPLIER=0.5

# Actualizacion de la app por sideload (GET /lsg-routes/app/version)
# APP_LATEST_VERSION=0.5.0
# APP_DOWNLOAD_URL=https://example.com/lsg-routes.apk
# APP_SHA256=
# APP_MINIMUM_VERSION=0.1.0

# Corredor de adherencia en metros
ADHERENCE_CORRIDOR_M=50
